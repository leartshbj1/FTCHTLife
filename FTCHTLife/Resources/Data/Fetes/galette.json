              "karma": -2,
              "happiness": 2,
              "stress": -2
            }
          },
          {
            "chance": 0.4,
            "text": "Le chef a vu ton manège. « Je n'aime pas les flatteurs. » Silence glacial à la machine à café.",
            "effects": {
              "stress": 5,
              "happiness": -3

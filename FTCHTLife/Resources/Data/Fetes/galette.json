        "label": "Laisser ta part",
        "outcomes": [
          {
            "chance": 1,
            "text": "Tu refuses ta part. Sandrine le prend personnellement et ne te salue plus jusqu'en mars.",
            "effects": {
              "health": 1,
              "happiness": -2
            }
          }
        ]
      }
    ]
  },

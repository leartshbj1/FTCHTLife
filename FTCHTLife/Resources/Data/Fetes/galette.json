  {
    "id": "fet_gal_0002",
    "category": "galette",
    "minAge": 3,
    "maxAge": 12,
    "weight": 5,
    "conditions": {},
    "text": "Tu as trouvé la fève : un minuscule facteur en porcelaine. Maintenant tu dois choisir qui sera ta reine ou ton roi.",
    "choices": [
      {
        "label": "Choisir un parent",
        "outcomes": [
          {
            "chance": 1,
            "text": "Tu couronnes un de tes parents. Il porte la couronne jusqu'au journal de 20 heures, très ému.",
            "effects": {
              "happiness": 4,
              "relationships": {
                "parent": 5
              }
            }
          }
        ]
      },
      {
        "label": "Choisir le chat",
        "outcomes": [
          {
            "chance": 0.6,
            "text": "Le chat accepte la couronne trois secondes, puis la mange. Règne court mais intense.",
            "effects": {
              "happiness": 6
            }
          },
          {
            "chance": 0.4,
            "text": "Le chat refuse la couronne d'un coup de patte. Tu as été rejeté{e} par ton propre sujet.",
            "effects": {
              "happiness": -2,
              "smarts": 1
            }
          }
        ]
      },
      {
        "label": "Se choisir soi-même",
        "outcomes": [
          {
            "chance": 1,
            "text": "Tu te couronnes toi-même, comme un empereur. La famille trouve ça un peu inquiétant.",
            "effects": {
              "happiness": 5,
              "karma": -2,
              "relationships": {
                "parent": -1
              }
            }
          }
        ]
      }
    ]
  },
  {
    "id": "fet_gal_0003",
    "category": "galette",
    "minAge": 4,
    "maxAge": 17,
    "weight": 5,
    "conditions": {
      "tags": [
        "siblings"
      ]
    },
    "text": "C'est {fratrie} qui est sous la table pour désigner les parts. Toi, tu as repéré une petite bosse suspecte dans la pâte.",
    "choices": [
      {
        "label": "Tricher discrètement",
        "outcomes": [
          {
            "chance": 0.5,
            "text": "Tu orientes le plat d'un millimètre. La fève est à toi, et personne n'a rien vu.",
            "effects": {
              "happiness": 6,
              "karma": -3
            }
          },
          {
            "chance": 0.5,
            "text": "{fratrie} t'a vu{e} tourner le plat. Scandale familial, couronne confisquée.",
            "effects": {
              "happiness": -4,
              "karma": -3,
              "relationships": {
                "sibling": -6
              },
              "setFlags": [
                "fete_gal_triche_fratrie"
              ]
            }
          }
        ]
      },
      {
        "label": "Jouer honnête",
        "outcomes": [
          {
            "chance": 1,
            "text": "Tu n'as pas la fève. Mais tu as ta dignité, et une part un peu plus grosse.",
            "effects": {
              "happiness": 1,
              "karma": 3
            }
          }
        ]
      },
      {
        "label": "Dénoncer la bosse",
        "outcomes": [
          {
            "chance": 1,
            "text": "Tu révèles l'emplacement de la fève à toute la tablée. Tu viens de tuer le suspense. {fratrie} t'en est quand même reconnaissant.",
            "effects": {
              "smarts": 1,
              "relationships": {
                "sibling": 3
              }
            }
          }
        ]
      }
    ]
  },

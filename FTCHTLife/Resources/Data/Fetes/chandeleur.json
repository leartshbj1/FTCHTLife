        "outcomes": [
          {
            "chance": 1,
            "text": "Tu laisses faire un adulte. Il rate. Tu ne dis rien, mais tu savoures.",
            "effects": {
              "happiness": 2,
              "smarts": 1
            }
          }
        ]
      }
    ]
  },
  {
    "id": "fet_cha_0003",
    "category": "chandeleur",
    "minAge": 18,
    "maxAge": 64,
    "weight": 5,
    "conditions": {},
    "text": "La tradition dit qu'il faut faire sauter la première crêpe en tenant une pièce dans l'autre main pour être riche toute l'année.",
    "choices": [
      {
        "label": "Avec une pièce",
        "outcomes": [
          {
            "chance": 0.5,
            "text": "Coïncidence : le lendemain tu retrouves 50 € dans une vieille veste. La crêpe a parlé.",
            "effects": {
              "money": 50,
              "happiness": 4
            }
          },
          {
            "chance": 0.5,
            "text": "La pièce glisse et tombe dans la pâte. Quelqu'un la trouvera plus tard avec ses dents.",
            "effects": {
              "happiness": -1
            }
          }
        ]
      },
      {
        "label": "Avec un billet",
        "outcomes": [
          {
            "chance": 1,
            "text": "Tu tiens un billet pour mettre toutes les chances de ton côté. Il est désormais couvert de pâte, et le distributeur le refuse.",
            "effects": {
              "money": -10,
              "happiness": 1
            }
          }
        ]
      },
      {
        "label": "Ne pas y croire",
        "outcomes": [
          {
            "chance": 1,
            "text": "Tu fais sauter la crêpe sans superstition. Elle tombe. Tu te demandes si c'est un signe.",
            "effects": {
              "smarts": 1,
              "stress": 1
            }
          }
        ]
      }
    ]
  },
  {
    "id": "fet_cha_0004",
    "category": "chandeleur",
    "minAge": 13,
    "maxAge": 17,
    "weight": 5,
    "conditions": {},
    "text": "Ton lycée organise un concours de crêpes. En finale, ton adversaire a apporté sa propre poêle, gravée à son nom.",
    "choices": [
      {
        "label": "Recette de grand-mère",
        "outcomes": [
          {
            "chance": 0.6,
            "text": "La recette de ta grand-mère écrase la concurrence. Tu gagnes une médaille en forme de crêpe.",

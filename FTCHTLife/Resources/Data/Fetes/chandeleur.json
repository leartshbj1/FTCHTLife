            }
          },
          {
            "chance": 0.5,
            "text": "Double salto, réception parfaite. Tu es une légende de la cuisine.",
            "effects": {
              "happiness": 8,
              "relationships": {
                "parent": 1
              }
            }
          }
        ]
      },

[
  {
    "id": "fet_cha_0001",
    "category": "chandeleur",
    "minAge": 0,
    "maxAge": 2,
    "weight": 5,
    "conditions": {},
    "text": "On t'a donné un morceau de crêpe. Tu ne sais pas encore si c'est un aliment, un chapeau ou une couverture.",
    "choices": [
      {
        "label": "Le manger",
        "outcomes": [
          {
            "chance": 1,
            "text": "Tu manges la crêpe. Tu découvres que la vie a un goût de sucre. Tout va changer.",
            "effects": {
              "happiness": 5
            }
          }
        ]
      },
      {
        "label": "Le porter sur la tête",
        "outcomes": [
          {
            "chance": 1,
            "text": "Tu portes la crêpe comme un béret. Tes parents prennent cent photos.",
            "effects": {
              "happiness": 3,
              "looks": 1,
              "relationships": {
                "parent": 2
              }
            }
          }
        ]
      },
      {
        "label": "Le donner au chien",
        "outcomes": [
          {
            "chance": 1,
            "text": "Le chien te jure fidélité éternelle. Tes parents te jurent un bain.",
            "effects": {
              "happiness": 2,
              "karma": 2
            }
          }
        ]
      }
    ]
  },
  {
    "id": "fet_cha_0002",
    "category": "chandeleur",
    "minAge": 4,
    "maxAge": 12,
    "weight": 5,
    "conditions": {},
    "text": "C'est ton tour de faire sauter la crêpe. Toute la famille retient son souffle autour de la poêle.",
    "choices": [
      {
        "label": "Sauter doucement",
        "outcomes": [
          {
            "chance": 0.7,
            "text": "La crêpe retombe pile dans la poêle. On t'applaudit comme au cirque.",

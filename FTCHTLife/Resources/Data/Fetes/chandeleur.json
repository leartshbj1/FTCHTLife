              "happiness": 6,
              "fame": 2
            }
          },
          {
            "chance": 0.4,
            "text": "Le jury trouve ta crêpe « honnête ». C'est le pire compliment possible.",
            "effects": {
              "happiness": -2
            }
          }
        ]
      },
      {
        "label": "Crêpe audacieuse",
        "outcomes": [
          {
            "chance": 0.5,
            "text": "Fromage, banane et piment. Un juré pleure, l'autre te donne 10/10.",
            "effects": {
              "happiness": 5,
              "fame": 2
            }
          },
          {
            "chance": 0.5,
            "text": "Fromage, banane et piment. Les deux jurés pleurent, et pas de joie.",
            "effects": {
              "happiness": -3,
              "health": -1
            }
          }
        ]
      },
      {
        "label": "Cacher sa poêle",
        "outcomes": [
          {
            "chance": 0.5,
            "text": "Sans sa poêle, ton adversaire panique. Tu gagnes, mais tu le sais, toi.",
            "effects": {
              "happiness": 3,
              "karma": -5
            }
          },
          {
            "chance": 0.5,
            "text": "On retrouve la poêle dans ton sac. Disqualification et surnom pour l'année.",
            "effects": {
              "happiness": -5,
              "karma": -4,
              "stress": 4
            }
          }
        ]
      }
    ]
  },

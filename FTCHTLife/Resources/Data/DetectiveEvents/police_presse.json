[
  {
    "id": "det_pol_0001",
    "kind": "police",
    "weight": 1,
    "unique": false,
    "conditions": {
      "affaireEnCours": true
    },
    "text": "Le commandant Vasseur, de la brigade criminelle, t'attend devant {agence}. « Votre affaire croise la mienne. Vous vous retirez, ou je vous retire. »",
    "choices": [
      {
        "label": "Coopérer",
        "outcomes": [
          {
            "chance": 0.7,
            "text": "Tu partages ce que tu sais. Il ne te remercie pas, mais il te rappelle la semaine suivante pour une question.",
            "effects": {
              "karma": 3
            },
            "agence": {
              "reputation": 3
            }
          },
          {
            "chance": 0.3,
            "text": "Il prend tout et ne te donne rien. Ton client apprend la suite dans le journal.",
            "effects": {
              "happiness": -4
            }
          }
        ]
      },
      {
        "label": "Continuer en parallèle",
        "outcomes": [
          {
            "chance": 0.5,
            "text": "Tu le devances d'un jour. Il ne te le pardonnera jamais, mais il te respecte.",
            "effects": {
              "smarts": 2
            },
            "agence": {
              "reputation": 5
            }
          },
          {
            "chance": 0.5,
            "text": "Il te fait convoquer pour entrave. Trois heures dans un couloir qui sent le café brûlé.",
            "effects": {
              "happiness": -6
            },
            "agence": {
              "plainte": true,
              "signal": "agence_plainte"
            }
          }
        ]
      },
      {
        "label": "Lui proposer un échange",
        "requiresSkill": {
          "eloquence": 2
        },
        "outcomes": [
          {
            "chance": 0.7,
            "text": "Une info contre une info. Le début d'une collaboration bizarre et efficace.",
            "effects": {
              "skills": {
                "eloquence": 2
              }
            },
            "agence": {
              "reputation": 4
            }
          },
          {
            "chance": 0.3,
            "text": "Il te rit au nez. Poliment."
          }
        ]
      }
    ]
  },
  {

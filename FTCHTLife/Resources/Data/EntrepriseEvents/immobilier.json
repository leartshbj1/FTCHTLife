            "effects": {
              "karma": -2
            }
          },
          {
            "chance": 0.5,
            "text": "Il trouve le château « trop château ». Tu as payé l'essence pour rien.",
            "business": {
              "elan": -5
            }
          }
        ]
      }
    ]
  },

            "chance": 1,
            "text": "Tu promets tout, puis découvres que les portes sont classées. Il t'attaque, en jaune.",
            "business": {
              "cash": -2000,
              "reputation": -6
            }
          }
        ]
      },
      {
        "label": "Lui proposer un château",
        "cost": 1000,
        "outcomes": [
          {
            "chance": 0.5,
            "text": "Il achète le château et repeint tout en jaune. Les monuments historiques pleurent.",
            "business": {
              "cash": 25000

    "text": "Le jour de la signature, un acheteur découvre que la « vue imprenable » annoncée par {entreprise} donne sur un mur. Imprenable, c'est vrai.",
    "choices": [
      {
        "label": "Accorder une remise",
        "cost": 2000,
        "outcomes": [
          {
            "chance": 1,
            "text": "L'acheteur signe et peint une fenêtre en trompe-l'œil sur le mur. Il la trouve plus belle que la vraie.",
            "business": {
              "reputation": 3
            }
          }
        ]
      },
      {
        "label": "Défendre l'annonce",
        "outcomes": [
          {
            "chance": 0.5,
            "text": "Le notaire confirme : le mur est effectivement imprenable. L'acheteur signe en grommelant.",
            "business": {
              "cash": 4000,
              "reputation": -5
            }
          },
          {
            "chance": 0.5,
            "text": "L'acheteur annule et publie la photo du mur à côté de ton annonce.",
            "business": {
              "cash": -1500,
              "reputation": -10
            }
          }
        ]
      },
      {
        "label": "Abattre le mur",
        "outcomes": [
          {
            "chance": 1,
            "text": "Le mur tombe. Derrière, il y a un autre mur.",

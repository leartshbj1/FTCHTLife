  },
  {
    "id": "nec_amour_0006",
    "section": "amour",
    "text": "Les derniers mots de {prenom} à {partenaire} auraient été « on n'a plus de lait ». Romantique jusqu'au bout.",
    "textFemale": null,
    "weight": 1,
    "conditions": {

[
  {
    "id": "nec_etudes_0001",
    "section": "etudes",
    "text": "{prenom} a quitté l'école tôt, estimant avoir fait le tour de la question après la leçon sur les volcans.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "sans_diplome"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0002",
    "section": "etudes",
    "text": "Sans diplôme mais pas sans opinions, {prenom} considérait le système scolaire comme une simple suggestion.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "sans_diplome"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0003",
    "section": "etudes",
    "text": "{Il} n'a jamais eu le bac, mais {il} avait toujours les réponses, souvent fausses, toujours sûres d'elles.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "sans_diplome"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0004",
    "section": "etudes",
    "text": "Titulaire du baccalauréat, {prenom} en parlait encore à {age} ans, à la moindre occasion.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "bachelier"
      ],
      "excludeTags": [],
      "minAge": 25,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0005",
    "section": "etudes",
    "text": "Le bac en poche, {prenom} a jugé que c'était bien assez de diplômes pour une seule vie.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "bachelier"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0006",
    "section": "etudes",
    "text": "Diplômé{e} en {filiere}, {prenom} n'a jamais cessé de le rappeler, y compris aux pigeons du parc.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "diplome_sup"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0007",
    "section": "etudes",
    "text": "Ses études de {filiere} lui ont appris beaucoup de choses, dont au moins deux utiles.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "diplome_sup"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0008",
    "section": "etudes",
    "text": "{prenom} a obtenu son diplôme de {filiere} avec la mention « on ne sait pas trop comment ».",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "diplome_sup"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0009",
    "section": "etudes",
    "text": "Titulaire d'un doctorat, {prenom} exigeait qu'on l'appelle « Docteur », y compris à la boulangerie.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "doctorat"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0010",
    "section": "etudes",
    "text": "Sa thèse de six cents pages a été lue en entier par deux personnes : son directeur de recherche et sa mère, qui n'a rien compris.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "doctorat"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0011",
    "section": "etudes",
    "text": "Ses études de médecine lui ont surtout appris à écrire de manière parfaitement illisible.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_medecine"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0012",
    "section": "etudes",
    "text": "Ses études de droit lui permettaient de gagner toutes les disputes familiales, sauf celles contre sa grand-mère.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_droit"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0013",
    "section": "etudes",
    "text": "Diplômé{e} en informatique, {prenom} réglait tous les problèmes en éteignant puis en rallumant. Même les problèmes de couple.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_informatique"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0014",
    "section": "etudes",
    "text": "Ses études de commerce lui ont appris à vendre n'importe quoi, y compris ses propres souvenirs de vacances.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_commerce"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0015",
    "section": "etudes",
    "text": "Après des études d'art, {prenom} a longtemps été incompris{e}, puis simplement ignoré{e}, ce qui est plus reposant.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_arts"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0016",
    "section": "etudes",
    "text": "Scientifique dans l'âme, {prenom} faisait des expériences sur tout, y compris sur la patience de ses colocataires.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_sciences"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0017",
    "section": "etudes",
    "text": "{prenom} est mort{e} en pleine année universitaire, ce qui l'aura au moins dispensé{e} des partiels.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "etudiant"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0018",
    "section": "etudes",
    "text": "Étudiant{e} jusqu'au bout, {prenom} laisse un mémoire inachevé et quarante onglets ouverts.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "etudiant"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0019",
    "section": "etudes",
    "text": "Élève brillant{e}, {prenom} a sauté deux classes, et en aurait sauté une troisième si on ne l'avait pas rattrapé{e} dans le couloir.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "intelligent"
      ],
      "excludeTags": [
        "bebe",
        "enfant"
      ],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0020",
    "section": "etudes",
    "text": "Les bulletins scolaires de {prenom} sont aujourd'hui conservés aux archives, rayon humour.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "bete"
      ],
      "excludeTags": [
        "bebe",
        "enfant"
      ],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0021",
    "section": "etudes",
    "text": "{prenom} quitte l'école primaire sans avoir appris la division, ce qui, entre nous, n'est pas une grande perte.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "enfant"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0022",
    "section": "etudes",
    "text": "{prenom} laisse un contrôle de maths inachevé, qui sera noté avec une indulgence exceptionnelle.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "ado"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0023",
    "section": "etudes",
    "text": "Sans le moindre diplôme, {prenom} a fini plus riche que tous ses professeurs réunis, et le leur rappelait à chaque Noël.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "sans_diplome",
        "riche"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0024",
    "section": "etudes",
    "text": "Bardé{e} de diplômes, {prenom} a prouvé qu'on pouvait avoir un bac+5 et un canapé à temps plein.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "diplome_sup",
        "chomeur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_etudes_0025",
    "section": "etudes",
    "text": "Malgré un doctorat, {prenom} n'a jamais compris comment fonctionnait la machine à café du laboratoire.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "doctorat",

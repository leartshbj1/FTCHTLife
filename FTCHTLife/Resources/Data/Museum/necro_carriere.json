[
  {
    "id": "nec_carriere_0001",
    "section": "carriere",
    "text": "{prenom} a exercé le métier de {metier} avec un dévouement que personne ne lui avait demandé.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0002",
    "section": "carriere",
    "text": "De profession, {prenom} était {metier}. {Il} parlait de vocation ; ses collègues, plutôt d'un malentendu.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0003",
    "section": "carriere",
    "text": "Au travail, {prenom} laisse un bureau impeccable, une plante verte en deuil et trois mails non lus.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0004",
    "section": "carriere",
    "text": "Son employeur a observé une minute de silence, puis a demandé qui reprenait ses dossiers.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0005",
    "section": "carriere",
    "text": "{prenom} est mort{e} en poste, ce qui, selon son contrat, ne compte pas comme une absence justifiée.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0006",
    "section": "carriere",
    "text": "Ses collègues retiendront sa ponctualité exemplaire, sauf le lundi, le vendredi et les jours de pluie.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0007",
    "section": "carriere",
    "text": "Exercer comme {metier} a rendu {prenom} riche, ce que ses collègues trouvent encore suspect.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur",
        "riche"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0008",
    "section": "carriere",
    "text": "Malgré des années comme {metier}, {prenom} n'a jamais compris où passait son salaire. Les enquêteurs non plus.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur",
        "fauche"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0009",
    "section": "carriere",
    "text": "Toujours en activité à {age} ans, {prenom} refusait la retraite, estimant que c'était « pour les vieux ».",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur",
        "vieux"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0010",
    "section": "carriere",
    "text": "Ses collègues ont organisé un pot en sa mémoire. Le plus joyeux de l'histoire de l'entreprise.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur",
        "mechant"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0011",
    "section": "carriere",
    "text": "{prenom} apportait des croissants tous les vendredis. L'entreprise envisage de donner son nom à la salle de pause.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur",
        "gentil"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0012",
    "section": "carriere",
    "text": "Toute l'équipe sera présente aux obsèques, ce qui ferme officiellement le service pour la journée.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur",
        "populaire"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0013",
    "section": "carriere",
    "text": "Sans emploi au moment des faits, {prenom} affirmait chercher activement du travail. Le canapé n'a pas souhaité commenter.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "chomeur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0014",
    "section": "carriere",
    "text": "{prenom} a envoyé quatre cents candidatures dans sa vie. Une réponse est arrivée ce matin, un peu tard.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "chomeur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0015",
    "section": "carriere",
    "text": "Entre deux emplois depuis plusieurs années, {prenom} considérait la pause comme une carrière à part entière.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "chomeur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0016",
    "section": "carriere",
    "text": "{prenom} n'avait pas de travail, mais un emploi du temps chargé : sieste, marché, sieste.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "chomeur",
        "heureux"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0017",
    "section": "carriere",
    "text": "À la retraite, {prenom} s'était lancé{e} dans une carrière très exigeante d'inspection des chantiers du quartier.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "retraite"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0018",
    "section": "carriere",
    "text": "Retraité{e} depuis des années, {prenom} parlait encore de son ancien bureau comme d'un pays natal.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "retraite"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0019",
    "section": "carriere",
    "text": "{prenom} vivait pleinement sa retraite : mots fléchés le matin, avis tranchés l'après-midi.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "retraite"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0020",
    "section": "carriere",
    "text": "Sa retraite dorée se partageait entre un golf, un voilier et une profonde incompréhension du prix du pain.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "retraite",
        "riche"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0021",
    "section": "carriere",
    "text": "Spécialiste reconnu{e} d'un domaine que trois personnes au monde comprennent, {prenom} laisse une œuvre impénétrable.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "doctorat"
      ],
      "excludeTags": [],
      "minAge": 25,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0022",
    "section": "carriere",
    "text": "Formé{e} à la médecine, {prenom} a soigné des centaines de patients et diagnostiqué tout le monde pendant les repas de famille.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_medecine",
        "travailleur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0023",
    "section": "carriere",
    "text": "Juriste redouté{e}, {prenom} lisait les conditions générales d'utilisation pour le plaisir.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_droit",
        "travailleur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0024",
    "section": "carriere",
    "text": "{prenom} laisse derrière son poste un code informatique que personne n'ose toucher, de peur que tout s'effondre.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_informatique",
        "travailleur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0025",
    "section": "carriere",
    "text": "Pur produit d'école de commerce, {prenom} transformait chaque conversation en réunion et chaque réunion en tableau.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_commerce",
        "travailleur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0026",
    "section": "carriere",
    "text": "Artiste incompris{e}, {prenom} voit déjà la cote de ses œuvres grimper. Il suffisait d'attendre, apparemment.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_arts"
      ],
      "excludeTags": [
        "bebe",
        "enfant"
      ],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0027",
    "section": "carriere",
    "text": "Dans son laboratoire, {prenom} laisse une expérience en cours. Ses collègues n'osent plus ouvrir le frigo.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "filiere_sciences",
        "travailleur"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0028",
    "section": "carriere",
    "text": "Côté carrière, {prenom} a connu des hauts, des bas, et surtout beaucoup de pauses café.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [],
      "excludeTags": [
        "bebe",
        "enfant",
        "ado"
      ],
      "minAge": 18,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0029",
    "section": "carriere",
    "text": "Son CV, retrouvé dans un tiroir, mentionnait « maîtrise du tableur » et « esprit d'équipe ». Les deux restent à vérifier.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [],
      "excludeTags": [
        "bebe",
        "enfant",
        "ado"
      ],
      "minAge": 18,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0030",
    "section": "carriere",
    "text": "Cerveau de son service, {prenom} répondait aux questions avant qu'on les pose, ce qui agaçait tout le monde.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur",
        "intelligent"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0031",
    "section": "carriere",
    "text": "Comme {metier}, {prenom} a mené une carrière marquée par l'audace : {il} ne lisait jamais les consignes.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur",
        "bete"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0032",
    "section": "carriere",
    "text": "À peine sorti{e} de sa période d'essai, {prenom} quitte son poste de {metier} de la manière la plus définitive qui soit.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "travailleur",
        "jeune"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0033",
    "section": "carriere",
    "text": "Sans emploi et criblé{e} de dettes, {prenom} avait une stratégie de carrière : attendre que l'économie s'excuse.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "chomeur",
        "endette"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0034",
    "section": "carriere",
    "text": "La retraite n'a jamais vraiment plu à {prenom}, qui passait encore devant son ancienne usine tous les matins, par habitude.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "retraite",
        "deprime"
      ],
      "excludeTags": [],
      "minAge": null,
      "maxAge": null
    }
  },
  {
    "id": "nec_carriere_0035",
    "section": "carriere",
    "text": "Un jour, {prenom} a pris un congé sabbatique. Personne n'a jamais su quand il s'était terminé.",
    "textFemale": null,
    "weight": 1,
    "conditions": {
      "tags": [
        "chomeur"
      ],
      "excludeTags": [],
      "minAge": 30,
      "maxAge": null
    }
  }
]
